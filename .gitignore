# Dependencies / build outputs
node_modules/
.next/
dist/
build/
coverage/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Needle private/local ingestion data
# Put Spotify extended-history exports here. Everything in this folder stays local.
/data/history/*
!/data/history/.gitkeep
!/data/history/README.md

# Legacy/private import locations
/data/private/
/imports/
/spotify-history/

# Protect against accidentally dropping exports back in the repo root
Streaming_History_Audio_*.json

# Temporary analysis/export outputs
*.tmp
*.log

# NOTE:
# Raw Spotify history is intentionally not tracked going forward.
# Older commits may still contain previously committed exports; removing those
# from historical Git objects requires a separate history rewrite.
